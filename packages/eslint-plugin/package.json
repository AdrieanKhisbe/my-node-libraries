{
  "name": "@-k/eslint-plugin",
  "version": "0.5.0",
  "description": "Personal Configuration by Adriean Khisbe for Eslint",
  "author": "Adriean Khisbe <adriean.khisbe@live.fr> (https://github.com/AdrieanKhisbe/)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "linter",
    "lint"
  ],
  "main": "src/index.cjs",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/AdrieanKhisbe/my-node-libraries/tree/master/packages/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrieanKhisbe/my-node-libraries.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/AdrieanKhisbe/my-node-libraries/issues"
  },
  "bin": {
    "eslint+": "./bin/eslint+"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.cjs",
    "_lint": "eslint",
    "test": "ava test/*.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "eslint": ">=8.2.0"
  },
  "dependencies": {
    "eslint-formatter-pretty": "^5.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-lodash-fp": "^2.2.0-a1",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^56.0.1",
    "prettier": "^3.9.10",
    "strip-json-comments": "^5.0.3"
  },
  "devDependencies": {
    "ava": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-self": "^1.2.1",
    "lodash": "^4.18.1"
  }
}
